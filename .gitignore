# ---------- Python 构建产物 ----------
build/
dist/
*.egg-info/
__pycache__/
*.pyc

# ---------- 虚拟环境 ----------
.venv/
venv/

# ---------- 测试 / 缓存 / 日志 ----------
marker_out/
*.log
mcp_timing.log
mcp-config.json

# ---------- 备份 ----------
.cleanup_backup/

# ---------- 客户资料（重要：禁止上传） ----------
Data/

